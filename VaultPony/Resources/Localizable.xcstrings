    "Typing both passwords together opens the outer vault with the hidden area protected, so you can add decoy files safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibst du beide Passwörter zusammen ein, öffnet sich der äußere Tresor und der versteckte Bereich bleibt geschützt. So kannst du gefahrlos Tarndateien hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si escribes ambas contraseñas a la vez, se abre la bóveda externa con el área oculta protegida, para que puedas añadir archivos señuelo con seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisir les deux mots de passe ensemble ouvre le coffre externe avec la zone cachée protégée, pour que vous puissiez y ajouter des fichiers leurres en toute sécurité."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

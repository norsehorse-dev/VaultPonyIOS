    "A vault is a single encrypted file. Put anything inside; only your password opens it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tresor ist eine einzelne verschlüsselte Datei. Lege alles hinein — nur dein Passwort öffnet ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bóveda es un único archivo cifrado. Guarda lo que quieras dentro; solo tu contraseña la abre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coffre est un unique fichier chiffré. Placez-y ce que vous voulez ; seul votre mot de passe l'ouvre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cofre é um único arquivo criptografado. Coloque qualquer coisa dentro; somente sua senha o abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище — это единый зашифрованный файл. Помещайте туда что угодно — открыть его может только ваш пароль."
          }
        }
      }
    },

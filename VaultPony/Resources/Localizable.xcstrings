    "Never write decrypted content outside the vault. Disables the copy-in fallback for containers that can't be edited in place, and asks for confirmation before every export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entschlüsselte Inhalte werden niemals außerhalb des Tresors geschrieben. Deaktiviert die Ausweichlösung über eine lokale Kopie für Container, die nicht direkt bearbeitet werden können, und fragt vor jedem Export um Bestätigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca escribe contenido descifrado fuera de la bóveda. Desactiva la alternativa de copia local para contenedores que no se pueden editar in situ y pide confirmación antes de cada exportación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'écrit jamais de contenu déchiffré en dehors du coffre. Désactive la solution de repli par copie locale pour les conteneurs qui ne peuvent pas être modifiés sur place, et demande une confirmation avant chaque exportation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca grava conteúdo descriptografado fora do cofre. Desativa o uso de cópia local como alternativa para contêineres que não podem ser editados no próprio arquivo e pede confirmação antes de cada exportação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не записывает расшифрованное содержимое за пределами хранилища. Отключает резервный вариант с локальной копией для контейнеров, которые нельзя редактировать на месте, и запрашивает подтверждение перед каждым экспортом."
          }
        }
      }
    },

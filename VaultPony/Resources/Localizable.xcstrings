    },
    "%@ was edited on a local copy because its location doesn't support editing in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde in einer lokalen Kopie bearbeitet, da der Speicherort keine direkte Bearbeitung unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se editó en una copia local porque su ubicación no admite la edición in situ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été modifié sur une copie locale car son emplacement ne permet pas la modification sur place."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi editado em uma cópia local porque o local não oferece suporte à edição no próprio arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл %@ был изменён в локальной копии, так как его расположение не поддерживает редактирование на месте."
          }
        }
      }
    },
    "%lld files are larger than 4 GB, which FAT can't store. They will be skipped." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Datei ist größer als 4 GB und kann von FAT nicht gespeichert werden. Sie wird übersprungen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Dateien sind größer als 4 GB und können von FAT nicht gespeichert werden. Sie werden übersprungen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld file is larger than 4 GB, which FAT can't store. It will be skipped."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld files are larger than 4 GB, which FAT can't store. They will be skipped."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivo supera los 4 GB y FAT no puede almacenarlo. Se omitirá."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld archivos superan los 4 GB y FAT no puede almacenarlos. Se omitirán."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld fichier dépasse 4 Go, la limite de FAT. Il sera ignoré."

    "Both restore actions below verify this password before writing anything — a wrong password leaves the container untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Wiederherstellungsaktionen unten überprüfen dieses Passwort, bevor etwas geschrieben wird — ein falsches Passwort lässt den Container unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambas acciones de restauración a continuación verifican esta contraseña antes de escribir nada; una contraseña incorrecta deja el contenedor intacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux actions de restauration ci-dessous vérifient ce mot de passe avant toute écriture — un mot de passe erroné laisse le conteneur intact."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Argon2id com este PIM precisa de cerca de %1$@ MB de memória, e o VaultPony pode usar cerca de %2$@ MB agora. O desbloqueio pode falhar."

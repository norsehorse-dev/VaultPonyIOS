            "value" : "Nicht genug freier Speicher für Argon2id (%lld MB nötig). Schließe andere Apps und versuche es erneut, oder wähle PBKDF2, falls dieser Tresor kein Argon2id nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

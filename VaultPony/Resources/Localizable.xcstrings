    "Carved from the outer volume's space — must leave enough room for the outer volume's own files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird aus dem Speicherplatz des äußeren Datenträgers herausgeschnitten — es muss genug Platz für die eigenen Dateien des äußeren Datenträgers bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reserva dentro del espacio del volumen externo; debe dejar suficiente espacio para los propios archivos del volumen externo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prélevé sur l'espace du volume externe — doit laisser assez de place pour les propres fichiers du volume externe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservado dentro do espaço do volume externo — deve deixar espaço suficiente para os próprios arquivos do volume externo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделяется из пространства внешнего тома — необходимо оставить достаточно места для собственных файлов внешнего тома."
          }
        }
      }
    },

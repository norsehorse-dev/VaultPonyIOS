    "Unlocks the outer volume read-write while refusing any write that would land in the hidden region." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperrt den äußeren Datenträger les- und schreibbar, verweigert aber jeden Schreibvorgang, der im versteckten Bereich landen würde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea el volumen externo en modo de lectura y escritura, pero rechaza cualquier escritura que caería en la región oculta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouille le volume externe en lecture-écriture tout en refusant toute écriture qui atterrirait dans la région cachée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueia o volume externo para leitura e gravação, mas recusa qualquer gravação que caia na região oculta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблокирует внешний том для чтения и записи, но отклоняет любую запись, которая попала бы в скрытую область."
          }
        }
      }
    },
    "Use the embedded backup when only the primary header is damaged. Use a saved backup file when both on-disk copies are gone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende das eingebettete Backup, wenn nur der primäre Header beschädigt ist. Verwende eine gespeicherte Backup-Datei, wenn beide Kopien auf dem Datenträger fehlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la copia de seguridad incorporada cuando solo el encabezado principal esté dañado. Usa un archivo de respaldo guardado cuando ambas copias en disco hayan desaparecido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la sauvegarde intégrée lorsque seul l'en-tête principal est endommagé. Utilisez un fichier de sauvegarde enregistré lorsque les deux copies sur disque ont disparu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o backup incorporado quando apenas o cabeçalho principal estiver danificado. Use um arquivo de backup salvo quando ambas as cópias em disco tiverem sido perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте встроенную резервную копию, если повреждён только основной заголовок. Используйте сохранённый резервный файл, если обе копии на диске утеряны."
          }
        }
      }
    },

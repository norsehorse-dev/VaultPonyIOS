    "The data inside the vault is untouched — only the password that unlocks it changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten im Tresor bleiben unverändert — nur das Passwort, mit dem er entsperrt wird, ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos dentro de la bóveda no se modifican; solo cambia la contraseña que la desbloquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

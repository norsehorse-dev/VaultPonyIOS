    },
    "VaultPony is part of the pony family of privacy tools: encryption you can inspect instead of taking a developer's word for it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VaultPony gehört zur Pony-Familie der Privatsphäre-Tools: Verschlüsselung, die du selbst überprüfen kannst, statt dem Wort eines Entwicklers vertrauen zu müssen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VaultPony forma parte de la familia Pony de herramientas de privacidad: cifrado que puedes inspeccionar en lugar de fiarte de la palabra de un desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VaultPony fait partie de la famille Pony d'outils de confidentialité : un chiffrement que vous pouvez vérifier vous-même plutôt que de faire confiance à la parole d'un développeur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VaultPony faz parte da família Pony de ferramentas de privacidade: criptografia que você pode inspecionar em vez de confiar na palavra de um desenvolvedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VaultPony — часть семейства Pony инструментов конфиденциальности: шифрование, которое можно проверить самостоятельно, а не просто поверить разработчику на слово."
          }

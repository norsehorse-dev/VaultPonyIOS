      }
    },
    "Face ID unlock, auto-lock when you leave, and a Privacy Screen keep your vaults yours." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face-ID-Entsperrung, automatische Sperre beim Verlassen und ein Sichtschutz halten deine Tresore für dich allein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desbloqueo con Face ID, el bloqueo automático al salir y una pantalla de privacidad mantienen tus bóvedas solo para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déverrouillage Face ID, le verrouillage automatique en quittant et un écran de confidentialité gardent vos coffres pour vous seul."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

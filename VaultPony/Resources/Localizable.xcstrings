      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstecke einen zweiten Tresor im ersten. Zwei Passwörter, und das äußere verrät nicht, dass das versteckte existiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta una segunda bóveda dentro de la primera. Dos contraseñas, y la exterior no da ninguna señal de que la oculta existe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachez un second coffre à l'intérieur du premier. Deux mots de passe, et l'extérieur ne laisse aucun signe de l'existence du caché."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte um segundo cofre dentro do primeiro. Duas senhas, e a externa não dá nenhum sinal de que a oculta existe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрячьте второе хранилище внутри первого. Два пароля, и внешний не даёт никакого намёка на существование скрытого."
          }
        }
      }
    },
    "Hides vault content in the app switcher when VaultPony isn't active. iOS has no way to block screen recordings or photos of the screen — this covers the switcher thumbnail only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbirgt Tresorinhalte im App-Wechsler, wenn VaultPony nicht aktiv ist. iOS bietet keine Möglichkeit, Bildschirmaufnahmen oder Fotos des Bildschirms zu blockieren — dies betrifft nur die Miniaturansicht im App-Wechsler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el contenido de la bóveda en el selector de apps cuando VaultPony no está activa. iOS no tiene forma de bloquear grabaciones o fotos de la pantalla; esto solo cubre la miniatura del selector."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque le contenu du coffre dans le sélecteur d'apps lorsque VaultPony n'est pas active. iOS ne permet pas de bloquer les enregistrements ou photos de l'écran — cela ne couvre que la vignette du sélecteur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta o conteúdo do cofre no alternador de apps quando o VaultPony não está ativo. O iOS não tem como bloquear gravações de tela ou fotos da tela — isso cobre apenas a miniatura do alternador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает содержимое хранилища в переключателе приложений, когда VaultPony неактивен. В iOS нет способа заблокировать запись экрана или фотографирование экрана — это касается только миниатюры в переключателе."
          }
        }
      }
    },
    "How long the vault stays unlocked with the app in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange der Tresor entsperrt bleibt, während sich die App im Hintergrund befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo permanece desbloqueada la bóveda con la app en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée pendant laquelle le coffre reste déverrouillé lorsque l'app est en arrière-plan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo o cofre permanece desbloqueado com o app em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как долго хранилище остаётся разблокированным, пока приложение находится в фоновом режиме."
          }
        }
      }
    },

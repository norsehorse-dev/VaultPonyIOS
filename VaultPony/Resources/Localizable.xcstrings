    "Hide a second vault inside the first. Two passwords, and the outer one gives no sign the hidden one exists." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstecke einen zweiten Tresor im ersten. Zwei Passwörter, und das äußere verrät nicht, dass das versteckte existiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta una segunda bóveda dentro de la primera. Dos contraseñas, y la exterior no da ninguna señal de que la oculta existe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachez un second coffre à l'intérieur du premier. Deux mots de passe, et l'extérieur ne laisse aucun signe de l'existence du caché."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte um segundo cofre dentro do primeiro. Duas senhas, e a externa não dá nenhum sinal de que a oculta existe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрячьте второе хранилище внутри первого. Два пароля, и внешний не даёт никакого намёка на существование скрытого."
          }
        }
      }
    },
    "Hide a second vault inside the first. Type its password on its own to open it. The outer password gives no sign it exists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstecke einen zweiten Tresor im ersten. Gib sein Passwort allein ein, um ihn zu öffnen. Das äußere Passwort verrät nicht, dass er existiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta una segunda bóveda dentro de la primera. Para abrirla, escribe solo su contraseña. La contraseña externa no da ninguna señal de que exista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachez un second coffre à l'intérieur du premier. Saisissez son mot de passe seul pour l'ouvrir. Le mot de passe externe ne révèle rien de son existence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte um segundo cofre dentro do primeiro. Digite só a senha dele para abri-lo. A senha externa não dá nenhum sinal de que ele existe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрячьте второе хранилище внутри первого. Чтобы открыть его, введите только его пароль. Внешний пароль не выдаёт его существования."
          }
        }
      }
    },
    "Hide password" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort verbergen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar contraseña"
          }
        },
        "fr" : {

    "Saves the container's 128 KiB header — encrypted, but keeps accepting the current password forever. Guard it like the container itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert den 128-KiB-Header des Containers — verschlüsselt, akzeptiert aber dauerhaft weiterhin das aktuelle Passwort. Behandle ihn genauso sorgfältig wie den Container selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el encabezado de 128 KiB del contenedor: está cifrado, pero seguirá aceptando la contraseña actual para siempre. Protégelo como al propio contenedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre l'en-tête de 128 Ko du conteneur — chiffré, mais continuera d'accepter le mot de passe actuel indéfiniment. Protégez-le comme le conteneur lui-même."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva o cabeçalho de 128 KiB do contêiner — criptografado, mas continuará aceitando a senha atual para sempre. Proteja-o como o próprio contêiner."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет 128-КиБ заголовок контейнера — он зашифрован, но будет бессрочно принимать текущий пароль. Храните его так же бережно, как и сам контейнер."
          }
        }
      }
    },

    "No-trace mode is on. Exporting \"%@\" writes a decrypted copy outside the vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der spurenlose Modus ist aktiviert. Beim Exportieren von „%@“ wird eine entschlüsselte Kopie außerhalb des Tresors geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo sin rastro está activado. Exportar «%@» escribe una copia descifrada fuera de la bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode sans trace est activé. L'exportation de « %@ » écrit une copie déchiffrée en dehors du coffre."
          }
        },
        "pt-BR" : {

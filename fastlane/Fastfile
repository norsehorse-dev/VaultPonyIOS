default_platform(:ios)

before_all do
  Dotenv.overload("../.env") if File.exist?("../.env")
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "Generate the Xcode project (xcodegen) -- run whenever project.yml or a source file list changes"
  lane :generate do
    # cwd for lane bodies is fastlane/, not the repo root -- project.yml
    # lives one level up.
    sh("cd .. && xcodegen generate")
  end

  desc "Archive and export a release .ipa via xcodebuild (automatic signing, no match -- solo team, one signer)"
  lane :build do
    generate
    # NOTE: `sh` runs with cwd = fastlane/, but fastlane ACTIONS
    # (build_app, deliver, ...) resolve relative paths against the repo
    # root you invoke fastlane from -- no "../" prefix here.
    build_app(
      project: "VaultPony.xcodeproj",
      scheme: "VaultPony",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "VaultPony.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Capture App Store screenshots across all six locales via the demo-vault UI test"
  lane :screenshots do
    generate
    capture_screenshots
  end

  desc "Build and upload the binary, metadata, and screenshots to App Store Connect for direct App Store distribution (no TestFlight). Does NOT submit for review by default -- run with submit:true when you're ready to actually submit."
  lane :release do |options|
    asc_api_key
    build
    deliver(
      ipa: "build/VaultPony.ipa",
      submit_for_review: options[:submit] == true,
      automatic_release: false,
      force: true,
      skip_binary_upload: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      # precheck can't inspect in-app purchases when authenticating with
      # an ASC API key (fastlane limitation) -- and VaultPony has none.
      precheck_include_in_app_purchases: false
    )
  end

  desc "Delete EVERY screenshot from the editable App Store version, all locales -- clears stuck/duplicated assets the ASC UI can't remove"
  lane :nuke_screenshots do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("dev.norsehorse.vaultpony")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    deleted = 0
    version.get_app_store_version_localizations.each do |localization|
      localization.get_app_screenshot_sets.each do |set|
        set.app_screenshots.each do |shot|
          shot.delete!
          deleted += 1
        end
      end
    end
    UI.success("Deleted #{deleted} screenshots")
  end

  desc "Repair the App Store screenshot set: make ASC exactly match fastlane/screenshots (removes duplicates), touching neither metadata nor the binary"
  lane :fix_screenshots do
    asc_api_key
    deliver(
      sync_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      force: true
    )
  end
end

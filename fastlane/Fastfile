default_platform(:ios)

before_all do
  Dotenv.overload(".env") if File.exist?(".env")
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  desc "Generate the Xcode project (xcodegen) -- run whenever project.yml or a source file list changes"
  lane :generate do
    sh("xcodegen", "generate")
  end

  desc "Archive and export a release .ipa via xcodebuild (automatic signing, no match -- solo team, one signer)"
  lane :build do
    generate
    build_app(
      scheme: "VaultPony",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "VaultPony.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Build and upload to TestFlight for internal (self) testing -- no external group, no beta review needed"
  lane :beta do
    asc_api_key
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Capture App Store screenshots across all six locales via the demo-vault UI test"
  lane :screenshots do
    generate
    capture_screenshots
  end

  desc "Upload metadata + screenshots to App Store Connect. Does NOT submit for review by default -- run with submit:true when you're ready to actually submit."
  lane :release do |options|
    asc_api_key
    deliver(
      submit_for_review: options[:submit] == true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true
    )
  end
end
